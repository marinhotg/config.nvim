#!/bin/bash
# Creates a git worktree in ../<repo>-wt/<name>
# Usage: git-wt-add <worktree-name> <branch-name>
# If worktree-name is empty, uses branch-name

WORKTREE_NAME="$1"
BRANCH_NAME="$2"

if [ -z "$BRANCH_NAME" ]; then
    echo "Usage: git-wt-add <worktree-name> <branch-name>"
    exit 1
fi

# Use branch name as worktree name if not provided
if [ -z "$WORKTREE_NAME" ]; then
    # Remove slashes from branch name for directory
    WORKTREE_NAME=$(echo "$BRANCH_NAME" | tr '/' '-')
fi

REPO=$(basename $(git rev-parse --show-toplevel))
WORKTREE_DIR="../${REPO}-wt"

mkdir -p "$WORKTREE_DIR"

# If branch exists, check it out; otherwise create it with -b
if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME" || \
   git show-ref --verify --quiet "refs/remotes/origin/$BRANCH_NAME"; then
    git worktree add "${WORKTREE_DIR}/${WORKTREE_NAME}" "$BRANCH_NAME"
else
    git worktree add -b "$BRANCH_NAME" "${WORKTREE_DIR}/${WORKTREE_NAME}"
fi

# Symlink Claude Code project memory so worktrees share the same memory
REPO_TOPLEVEL=$(git rev-parse --show-toplevel)
REPO_ABSPATH=$(cd "$REPO_TOPLEVEL" && pwd)
WT_ABSPATH=$(cd "${WORKTREE_DIR}/${WORKTREE_NAME}" && pwd)

CLAUDE_PROJECTS="$HOME/.claude/projects"
REPO_PROJECT_DIR="${CLAUDE_PROJECTS}/$(echo "$REPO_ABSPATH" | tr '/_' '--')"
WT_PROJECT_DIR="${CLAUDE_PROJECTS}/$(echo "$WT_ABSPATH" | tr '/_' '--')"

if [ -d "$REPO_PROJECT_DIR" ] && [ ! -e "$WT_PROJECT_DIR" ]; then
    ln -s "$REPO_PROJECT_DIR" "$WT_PROJECT_DIR"
fi
